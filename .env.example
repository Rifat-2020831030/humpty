# ==============================================================================
# GariKoi (গাড়ী কই?) Environment Configuration
# ==============================================================================
# Note: GariKoi works 100% out-of-the-box with zero required environment setup!
# All variables below are optional and have sensible built-in defaults.
# ==============================================================================

# [OPTIONAL] Google Gemini API Key
# Enables live natural language AI destination queries (e.g. "3 buildings past Dhanmondi Boys High School").
# If omitted or left empty, GariKoi seamlessly uses its built-in Dhaka Landmark & Fuzzy Matching Engine.
GEMINI_API_KEY=

# [OPTIONAL] Server Port (Default: 3000)
PORT=3000

# [OPTIONAL] Database Connection URL (Default: file:./dev.db in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
